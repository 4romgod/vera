VERA_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=vera-gpt-oss-20b-32k:latest
# Images use a vision-capable model without coupling the orchestration brain to
# multimodal support.
VERA_VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Set a supported reasoning level only after the model passes `npm run test:model`.
OLLAMA_THINK=medium
# Optional owner-controlled voice transcription through a separately running
# loopback whisper.cpp server.
# VERA_TRANSCRIPTION_PROVIDER=whisper_cpp
# WHISPER_CPP_BASE_URL=http://127.0.0.1:8080
# WHISPER_CPP_MODEL=large-v3-turbo
# Optional owner-controlled neural speech. `npm run vera:install` installs and
# supervises the locked Python sidecar when this provider is selected.
# VERA_SPEECH_PROVIDER=pocket_tts
# POCKET_TTS_BASE_URL=http://127.0.0.1:8091
# POCKET_TTS_VOICE=alba
# POCKET_TTS_ALLOWED_VOICES=alba,anna
# Enable only after starting `npm run dev:transcription` and
# `npm run dev:livekit`; use the private WSS URL printed by tailscale:status.
# VERA_LIVE_VOICE_ENABLED=true
# LIVEKIT_SERVER_URL=ws://127.0.0.1:7880
# LIVEKIT_PUBLIC_URL=wss://macmini.your-tailnet.ts.net/livekit
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
