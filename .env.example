HOST=127.0.0.1
PORT=4310
# Development uses readable terminal logs. Set json to force production-style NDJSON.
# VERA_LOG_FORMAT=json
MODEL_TIMEOUT_MS=120000
MODEL_READINESS_TIMEOUT_MS=3000
MODEL_MAX_OUTPUT_TOKENS=8192
CONVERSATION_CONTEXT_MAX_MESSAGES=20
CONVERSATION_CONTEXT_MAX_CHARACTERS=40000
VERA_STORAGE_MODE=persistent
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=vera
REDIS_URL=redis://127.0.0.1:6379
SCRATCHPAD_TTL_SECONDS=86400
DEPENDENCY_TIMEOUT_MS=3000
VERA_PLANNING_ADAPTER=codex_cli
VERA_CHANGE_ADAPTER=codex_cli
CODEX_COMMAND=codex
# CODEX_MODEL=gpt-5.6-codex
# CHANGE_CODEX_COMMAND=codex
# CHANGE_CODEX_MODEL=gpt-5.6-codex
# Public-web research is disabled until an explicit third-party adapter is selected.
VERA_RESEARCH_ADAPTER=disabled
# Set these when VERA_RESEARCH_ADAPTER=openai_web_search.
# RESEARCH_OPENAI_BASE_URL=https://api.openai.com/v1
# RESEARCH_OPENAI_MODEL=gpt-5.4-mini
# RESEARCH_OPENAI_API_KEY=replace-with-your-openai-api-key
# RESEARCH_SEARCH_CONTEXT_SIZE=medium
# Voice transcription is independent from the orchestration brain. Completed
# recordings are ephemeral and never written to Vera's durable stores.
VERA_TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_TIMEOUT_MS=120000
TRANSCRIPTION_MAX_AUDIO_BYTES=25000000
# OpenAI transcription (third-party boundary):
# TRANSCRIPTION_OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_OPENAI_MODEL=gpt-transcribe
# TRANSCRIPTION_OPENAI_API_KEY=replace-with-your-openai-api-key
# Local transcription (owner-controlled loopback boundary):
# WHISPER_CPP_BASE_URL=http://127.0.0.1:8080
# WHISPER_CPP_MODEL=large-v3-turbo
# Durable managed Git worktrees for approved software-change applications.
# Keep this outside every registered project. Defaults to ~/.vera/change-applications.
# CHANGE_APPLICATION_ROOT=/absolute/path/to/vera-change-applications
GIT_COMMAND=git
GH_COMMAND=gh
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_MS=900000
# Reminder interpretation and durable scheduler settings.
VERA_OWNER_TIME_ZONE=Africa/Johannesburg
REMINDER_WORKER_CONCURRENCY=2
REMINDER_POLL_INTERVAL_MS=500
REMINDER_LEASE_MS=30000
