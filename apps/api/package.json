{
  "name": "@vera/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/server.js",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "dev": "NODE_ENV=development tsx watch --clear-screen=false --exclude 'dist/**' --exclude 'node_modules/**' --include '../../.env*' src/server.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check && redocly lint openapi/vera.openapi.json --extends=minimal",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "start": "node dist/server.js",
    "test": "tsx --test 'test/**/*.test.ts'",
    "test:model": "tsx src/bootstrap/diagnostics/test-model.ts",
    "test:ollama": "VERA_MODEL_PROVIDER=ollama tsx src/bootstrap/diagnostics/test-model.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@livekit/agents": "^1.8.0",
    "@livekit/agents-plugin-silero": "^1.8.0",
    "@livekit/rtc-node": "^0.13.34",
    "fastify": "5.12.1",
    "heic-convert": "^2.1.0",
    "livekit-server-sdk": "^2.18.0",
    "mongodb": "^7.6.0",
    "pdfjs-dist": "^6.2.108",
    "redis": "^6.2.1",
    "sharp": "^0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.8.1",
    "@redocly/cli": "^2.51.2",
    "openapi-types": "^12.1.3",
    "pino-pretty": "13.1.3",
    "prettier": "^3.6.2"
  }
}
