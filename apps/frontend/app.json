{
  "expo": {
    "name": "Vera",
    "slug": "vera-frontend",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "vera",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Vera to record your voice until you choose to stop."
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.vera.app"
    },
    "android": {
      "package": "dev.vera.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
