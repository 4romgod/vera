{
  "name": "@vera/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vera": "dist/bin.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "predev": "npm run build --workspace @vera/client",
    "dev": "tsx src/bin.ts",
    "pretest": "npm run build --workspace @vera/client",
    "test": "tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vera/client": "0.1.0"
  }
}
